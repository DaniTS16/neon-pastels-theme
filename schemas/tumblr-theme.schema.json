{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://luvmedia.group/schemas/tumblr-theme.schema.json",
  "title": "Neon Pastels Tumblr Theme Schema",
  "type": "object",
  "required": [
    "theme",
    "branding",
    "theme_options",
    "color_system",
    "motion_system",
    "accessibility"
  ],
  "properties": {
    "theme": {
      "type": "object",
      "required": [
        "name",
        "version",
        "status"
      ],
      "properties": {
        "name": {
          "type": "string"
        },
        "version": {
          "type": "string",
          "pattern": "^\\d+\\.\\d+\\.\\d+$"
        },
        "status": {
          "type": "string",
          "enum": [
            "Theme Garden Ready",
            "Draft",
            "Deprecated"
          ]
        },
        "description": {
          "type": "string"
        }
      }
    },
    "branding": {
      "type": "object",
      "required": [
        "parent_company",
        "public_brand",
        "legal_copy"
      ],
      "properties": {
        "parent_company": {
          "type": "object",
          "required": ["name", "public_facing"],
          "properties": {
            "name": {
              "type": "string"
            },
            "public_facing": {
              "type": "boolean",
              "const": false
            }
          }
        },
        "public_brand": {
          "type": "object",
          "required": ["name", "public_facing"],
          "properties": {
            "name": {
              "type": "string"
            },
            "operates_as": {
              "type": "string"
            },
            "public_facing": {
              "type": "boolean",
              "const": true
            }
          }
        },
        "legal_copy": {
          "type": "object",
          "required": ["required_format", "display_condition"],
          "properties": {
            "required_format": {
              "type": "string",
              "const": "IRI National d/b/a Luv Media Group"
            },
            "display_condition": {
              "type": "string",
              "enum": [
                "public_mode_only"
              ]
            }
          }
        },
        "private_mode": {
          "type": "object",
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "effect": {
              "type": "string",
              "enum": [
                "remove_legal_footer"
              ]
            }
          }
        }
      }
    },
    "brand_lock": {
      "type": "object",
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "lock_level": {
          "type": "string",
          "enum": ["strict", "moderate", "loose"]
        },
        "rules": {
          "type": "object"
        },
        "exceptions": {
          "type": "object"
        }
      }
    },
    "theme_options": {
      "type": "object",
      "required": [
        "booleans",
        "selects"
      ],
      "properties": {
        "booleans": {
          "type": "object",
          "properties": {
            "DarkModeDefault": {
              "type": "boolean"
            },
            "EnableLogoAnimation": {
              "type": "boolean"
            },
            "ReduceMotion": {
              "type": "boolean"
            },
            "LuvOnlyMode": {
              "type": "boolean"
            }
          }
        },
        "selects": {
          "type": "object",
          "properties": {
            "ColorPalette": {
              "type": "string",
              "enum": [
                "Pastel",
                "Peach",
                "Lilac",
                "Neon"
              ]
            },
            "LayoutStyle": {
              "type": "string",
              "enum": [
                "Single",
                "Wide",
                "Magazine"
              ]
            },
            "MotionPreset": {
              "type": "string",
              "enum": [
                "Subtle",
                "Brand",
                "Static"
              ]
            },
            "NeonGlowIntensity": {
              "type": "string",
              "enum": [
                "Soft",
                "Medium",
                "Strong"
              ]
            }
          }
        },
        "text": {
          "type": "object",
          "properties": {
            "FooterText": {
              "type": "string"
            }
          }
        }
      }
    },
    "color_system": {
      "type": "object",
      "required": [
        "palettes",
        "wcag"
      ],
      "properties": {
        "active_palette": {
          "type": "string"
        },
        "palettes": {
          "type": "object",
          "additionalProperties": {
            "type": "object",
            "required": [
              "background",
              "foreground"
            ],
            "properties": {
              "background": {
                "type": "string",
                "pattern": "^#([A-Fa-f0-9]{6})$"
              },
              "foreground": {
                "type": "string",
                "pattern": "^#([A-Fa-f0-9]{6})$"
              },
              "accents": {
                "type": "array",
                "items": {
                  "type": "string",
                  "pattern": "^#([A-Fa-f0-9]{6})$"
                }
              }
            }
          }
        },
        "wcag": {
          "type": "object",
          "required": ["standard", "status"],
          "properties": {
            "standard": {
              "type": "string",
              "enum": [
                "WCAG 2.1 AA"
              ]
            },
            "status": {
              "type": "string",
              "enum": [
                "PASS"
              ]
            }
          }
        }
      }
    },
    "layout_system": {
      "type": "object",
      "required": ["active_layout", "layouts"],
      "properties": {
        "active_layout": {
          "type": "string"
        },
        "layouts": {
          "type": "object",
          "additionalProperties": {
            "type": "object",
            "required": ["max_width", "columns"],
            "properties": {
              "max_width": {
                "type": "string"
              },
              "columns": {
                "type": "integer",
                "minimum": 1
              },
              "column_gap": {
                "type": "string"
              }
            }
          }
        }
      }
    },
    "motion_system": {
      "type": "object",
      "required": [
        "tokens",
        "presets",
        "reduced_motion"
      ],
      "properties": {
        "tokens": {
          "type": "object",
          "required": ["logo_duration", "easing"],
          "properties": {
            "logo_duration": {
              "type": "string"
            },
            "easing": {
              "type": "string"
            }
          }
        },
        "active_preset": {
          "type": "string"
        },
        "presets": {
          "type": "object",
          "required": ["Subtle", "Brand", "Static"],
          "properties": {
            "Subtle": {
              "type": "object"
            },
            "Brand": {
              "type": "object"
            },
            "Static": {
              "type": "object"
            }
          }
        },
        "reduced_motion": {
          "type": "object",
          "required": ["supports_system_preference", "supports_theme_option"],
          "properties": {
            "supports_system_preference": {
              "type": "boolean",
              "const": true
            },
            "supports_theme_option": {
              "type": "boolean",
              "const": true
            },
            "behavior": {
              "type": "string"
            }
          }
        }
      }
    },
    "logo_system": {
      "type": "object",
      "properties": {
        "animated": {
          "type": "object",
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "fallback": {
              "type": "string"
            }
          }
        },
        "static": {
          "type": "object",
          "properties": {
            "always_present": {
              "type": "boolean",
              "const": true
            }
          }
        }
      }
    },
    "accessibility": {
      "type": "object",
      "required": [
        "keyboard_navigation",
        "skip_link",
        "aria_landmarks",
        "reduced_motion"
      ],
      "properties": {
        "keyboard_navigation": {
          "type": "boolean",
          "const": true
        },
        "skip_link": {
          "type": "boolean",
          "const": true
        },
        "aria_landmarks": {
          "type": "boolean",
          "const": true
        },
        "reduced_motion": {
          "type": "boolean",
          "const": true
        },
        "color_contrast": {
          "type": "string"
        }
      }
    },
    "theme_garden": {
      "type": "object",
      "properties": {
        "status": {
          "type": "string",
          "enum": [
            "Ready"
          ]
        },
        "previews": {
          "type": "object",
          "properties": {
            "desktop": {
              "type": "string"
            },
            "tablet": {
              "type": "string"
            },
            "mobile": {
              "type": "string"
            }
          }
        },
        "disallowed_features": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "external tracking",
              "obfuscated code",
              "JSON parsing",
              "JS animation timelines"
            ]
          }
        }
      }
    }
  }
}
